@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = Localizer["Products_Title"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="mb-0">@Localizer["Products_Heading"]</h1>
    <a class="btn btn-primary" asp-action="Create">@Localizer["Products_Add"]</a>
</div>

@if (ViewData["ApiError"] is true)
{
    <div class="alert alert-warning" role="alert">@Localizer["Products_ApiError"]</div>
}
else if (!Model.Any())
{
    <p class="text-muted">@Localizer["Products_Empty"]</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-break">@product.Name</h5>
                        <p class="card-text fs-5">@product.Price.ToString("C")</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post"
                              data-confirm="@Localizer["Products_DeleteConfirm", product.Name]"
                              onsubmit="return confirm(this.dataset.confirm);">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">@Localizer["Products_Delete"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
